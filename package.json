{
  "name": "nexus",
  "productName": "Nexus",
  "version": "1.1.0",
  "description": "All your web apps in one window, each account in its own isolated session.",
  "author": "Mehdi Joyen",
  "license": "MIT",
  "homepage": "https://nexusmessenger.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrJOYEN/nexus-messenger.git"
  },
  "bugs": {
    "url": "https://github.com/MrJOYEN/nexus-messenger/issues"
  },
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "build:store": "electron-builder --win appx --publish never --config electron-builder.store.js"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mehdi.nexus",
    "productName": "Nexus",
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "files": [
      "**/*",
      "!assets/brand/**",
      "!installer/**",
      "!docs/**",
      "!test/**",
      "!**/*.md",
      "!.*",
      "!electron-builder.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "installer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus"
    },
    "appx": {
      "identityName": "MehdiJoyen.NexusMessenger",
      "publisher": "CN=3AEA6691-12A7-4EC5-B304-754AC77D0730",
      "publisherDisplayName": "Mehdi Joyen",
      "applicationId": "Nexus",
      "displayName": "Nexus Messenger",
      "backgroundColor": "#1e1e2e",
      "languages": [
        "en-US",
        "fr-FR",
        "es-ES"
      ],
      "customExtensionsPath": "installer/appx-extensions.xml",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.19041.0",
      "showNameOnTiles": false,
      "electronUpdaterAware": false,
      "setBuildNumber": false,
      "artifactName": "${productName}-${version}-store.msix"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MrJOYEN",
        "repo": "nexus-messenger"
      }
    ]
  }
}
